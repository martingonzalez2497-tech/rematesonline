# Copiá este archivo a ".env" y completá tus propios valores.
# El .env real NUNCA se sube a git ni se comparte.

PORT=3000

# Clave secreta para firmar los tokens de sesión (JWT).
# Generá una propia larga y al azar, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar-esto-por-una-clave-larga-y-secreta

# Origen permitido para las peticiones del frontend (Live Server usa el 5500)
FRONTEND_ORIGIN=http://127.0.0.1:5500
